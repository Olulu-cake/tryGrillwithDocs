# Application Settings
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Database (PostgreSQL)
# DATABASE_URL format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Recommended: Ensure connection pooling is configured (e.g., pgBouncer)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public&connection_limit=10"

# Redis (Caching/Sessions)
# Format: redis://[:password@]host[:port][/db-number]
REDIS_URL="redis://:password@localhost:6379/0"

# Security
JWT_SECRET=replace_with_a_secure_random_string
HMAC_WEBHOOK_SECRET=replace_with_a_secure_random_string

# Third-Party APIs
STRIPE_API_KEY=sk_live_...
SHIPPING_PROVIDER_API_KEY=...

# Networking
CORS_ALLOWED_ORIGINS="https://app.yourdomain.com"
